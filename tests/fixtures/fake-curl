#!/bin/sh
# Fake curl: intercepts reviewdog install URL and serves a canned payload.
# Supports both "curl URL | sh" (stdout) and hardened "curl -o FILE URL" (write to file).

out=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -o|--output) out="$arg" ;;
  esac
  prev="$arg"
done

case "$*" in
  *reviewdog*)
    PAYLOAD="${GITHUB_WORKSPACE}/tests/fixtures/fake-reviewdog-install.sh"
    if [ -n "$out" ]; then
      cat "$PAYLOAD" > "$out"
    else
      cat "$PAYLOAD"
    fi
    exit 0
    ;;
esac

# Fall through to real curl for other URLs
exec /usr/bin/curl "$@"
